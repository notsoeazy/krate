<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window background while
         the Flutter UI initializes (shortly after the splash screen). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on the Android side while the Flutter UI loads -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launcher_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the Flutter UI renders.
         This theme determines the color of the Android Window background behind
         the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@color/launcher_background</item>
    </style>
</resources>
